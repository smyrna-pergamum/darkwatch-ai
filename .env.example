# ============================================================================
# DarkWatch AI 0.2.1 - copy to .env and adjust. Every value has a safe default.
# ============================================================================

# --- Tor ---------------------------------------------------------------------
TOR_ENABLED=true
# Crawls refuse to start unless traffic is verified to leave through Tor.
TOR_REQUIRED=true
TOR_PROXY_HOST=127.0.0.1
TOR_PROXY_PORT=9050            # 9150 when using Tor Browser
TOR_CONTROL_PORT=9051
TOR_CONTROL_PASSWORD=
TOR_NEWNYM_EVERY_RUN=false

# --- Crawler -------------------------------------------------------------------
CRAWL_DEPTH=2
CRAWL_MAX_PAGES=50
CRAWL_DELAY_SEC=2
CRAWL_SCOPE=same_site          # same_site | allowed | any_onion
ALLOWED_DOMAINS=
MAX_RESPONSE_BYTES=2000000
CRAWL_CONCURRENCY=1

# --- Storage / data protection (GDPR) ------------------------------------------
DATABASE_URL=sqlite:///data/monitor.db
STORE_PAGE_CONTENT=true
RETENTION_DAYS=90

# --- AI ------------------------------------------------------------------------
# More providers (LM Studio, vLLM, OpenRouter, Groq, any OpenAI-compatible API)
# can be added in the dashboard under "AI & Models".
AI_ROUTING=hybrid              # local | cloud | hybrid
LOCAL_AI_BACKEND=ollama        # ollama | llamacpp
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192

# llama.cpp (GGUF): server = your own llama-server, managed = app starts it, embedded = llama-cpp-python
LLAMACPP_MODE=server
LLAMACPP_BASE_URL=http://127.0.0.1:8080
LLAMACPP_SERVER_BIN=llama-server
LLAMACPP_PORT=8089
LLAMACPP_CTX=8192
LLAMACPP_GPU_LAYERS=0
MODELS_DIR=data/models
HF_TOKEN=                      # for gated / private Hugging Face repos

# Small models: inputs are chunked to fit the context window
AI_DEFAULT_CONTEXT=4096        # assumed window when it cannot be detected
AI_REMOTE_CONTEXT=32000
AI_PAGE_MAX_CHARS=40000
AI_CLOUD_PROVIDER=openai       # openai | anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
CLOUD_ALLOW_RAW=false          # never send raw dark-web text to the cloud
CLOUD_REDACT=true
AGENT_MAX_STEPS=25
AI_TASK_PLANNER=true
AUTO_APPROVE_TASKS=recrawl     # add_target is never auto-approved

# --- AI analyst agent ------------------------------------------------------------
ANALYST_ENABLED=true
ANALYST_PROVIDER=auto          # auto | rules | db:<id> | env:ollama | env:llamacpp
ANALYST_MAX_STEPS=12
ANALYST_AUTO_APPROVE=read,annotate,external
ANALYST_ASK=write              # these tool levels wait for human approval
ANALYST_PERMISSIONS=           # e.g. set_alert_status=ask,add_watch_term=deny
ANALYST_AUTO_SEVERITY=high     # auto-investigate new alerts >= this ("" = off)
ANALYST_AUTO_MAX_PER_HOUR=6

# --- External intelligence sources ---------------------------------------------
SOURCES_INTERVAL_MIN=720
HIBP_API_KEY=
INTELX_API_KEY=
INTELX_BASE_URL=https://2.intelx.io
RANSOMWARE_LIVE_ENABLED=true
RANSOMWARE_LIVE_API_KEY=
AHMIA_ENABLED=false

# --- Threat feeds & enrichment -------------------------------------------------
FEEDS_ENABLED=true
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
ABUSECH_AUTH_KEY=

# --- DarkWatch: evidence, risk, actors, IncidentForge --------------------------
EVIDENCE_ENABLED=true
EVIDENCE_DIR=                  # default: data/evidence
EVIDENCE_AUTO_SEVERITY=high    # capture evidence automatically for alerts >= this ("" = off)
RISK_HALF_LIFE_DAYS=14
RISK_WINDOW_DAYS=90
ACTOR_PROFILING=true
FORUM_PARSING=true
INCIDENTFORGE_URL=             # e.g. https://incidentforge.example
INCIDENTFORGE_API_KEY=
INCIDENTFORGE_INCIDENT_PATH=/api/v1/incidents
INCIDENTFORGE_VERIFY_TLS=true
INCIDENTFORGE_AUTO_SEVERITY=   # e.g. critical
INCIDENTFORGE_INCLUDE_EVIDENCE=true

# --- MISP ----------------------------------------------------------------------
MISP_URL=
MISP_API_KEY=
MISP_VERIFY_SSL=true
MISP_AUTO_PUSH_SEVERITY=

# --- Alerts --------------------------------------------------------------------
ALERT_MIN_SEVERITY=medium
ALERT_CONSOLE=true
ALERT_FILE=true
ALERT_WEBHOOK_URL=             # Discord / Slack / Teams / generic JSON (auto-detected)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
AI_TRIAGE=true
AI_TRIAGE_SUPPRESS=false

# --- Scheduler / API -----------------------------------------------------------
SCHEDULER_ENABLED=true
DEFAULT_INTERVAL_MIN=360
API_HOST=127.0.0.1
API_PORT=8000
API_KEY=                       # required if API_HOST is not 127.0.0.1
CORS_ORIGINS=
