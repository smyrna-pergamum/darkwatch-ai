# Tor proxy (9050 = tor daemon, 9150 = Tor Browser)
TOR_ENABLED=true
TOR_PROXY_HOST=127.0.0.1
TOR_PROXY_PORT=9050
REQUEST_TIMEOUT=30

# Crawler
CRAWL_DEPTH=2
CRAWL_MAX_PAGES=50
CRAWL_DELAY_SEC=2
ALLOWED_DOMAINS=

# Database
DATABASE_URL=sqlite:///data/monitor.db

# AI - local (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_ENABLED=true

# AI - cloud (fill at least one)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Routing: local | cloud | hybrid
AI_ROUTING=hybrid
AI_CLOUD_PROVIDER=openai

# Alerts
ALERT_WEBHOOK_URL=
ALERT_MIN_SEVERITY=medium
ALERT_CONSOLE=true
ALERT_FILE=true

# Scheduler
SCHEDULE_INTERVAL_MIN=60